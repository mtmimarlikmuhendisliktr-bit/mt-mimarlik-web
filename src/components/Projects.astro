---
import { ArrowRight } from 'lucide-astro';
---
<!-- 6. Mimari Detaylar -->
<section id="detaylar" class="home-details" aria-labelledby="detaylar-baslik">
  <div class="home-details__inner">
    <div class="home-details__copy">
      <p class="home-kicker">Detaylara Bakış</p>
      <h2 id="detaylar-baslik" class="home-details__title">
        Her detay,<br />bütünün bir parçası.
      </h2>
      <p class="home-details__text">
        Malzeme, ışık, oran ve mekânsal ilişkiler; güçlü bir mimari dilin temelini oluşturur.
      </p>
    </div>

    <figure class="home-details__media">
      <div class="home-details__frame">
        <img
          src="/images/home/zeytinlik-avlu.jpg"
          alt="Konsept mimari görsel: zeytinlik avlu geçidi ve malzeme detayı"
          width="1536"
          height="1024"
          class="home-details__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>
  </div>
</section>

<!-- 7. Çalışma Alanları -->
<section id="projeler" class="home-areas" aria-labelledby="calisma-alanlari-baslik">
  <div class="home-areas__intro">
    <p class="home-kicker">Çalışma Alanlarımız</p>
    <h2 id="calisma-alanlari-baslik" class="home-areas__title">
      Mimariye farklı<br />ölçeklerden bakıyoruz.
    </h2>
  </div>

  <div class="home-areas__visuals">
    <figure class="home-areas__hero">
      <div class="home-areas__frame home-areas__frame--wide">
        <img
          src="/images/home/sahil-villa.jpg"
          alt="Konsept mimari görsel: altın saatte modern sahil villası"
          width="1672"
          height="941"
          class="home-areas__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <figure class="home-areas__collage">
      <div class="home-areas__frame home-areas__frame--collage">
        <img
          src="/images/home/mimari-kolaj.jpg"
          alt="Konsept mimari görsel: modern mimarlık kolajı ve villa manzaraları"
          width="1536"
          height="1024"
          class="home-areas__img home-areas__img--contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>
  </div>

  <div class="home-areas__footer">
    <p class="home-areas__note">
      Görseller, mimari yaklaşımımızı temsil eden konsept çalışmalardır; tamamlanmış M&T projelerini göstermez.
    </p>
    <a href="/projeler" class="home-text-link">
      Çalışma Alanlarımızı Keşfedin <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .home-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #6f6d67;
  }

  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    border-bottom: 1px solid #121212;
    padding-bottom: 0.15rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #121212;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-text-link:hover {
    opacity: 0.55;
  }

  .home-details {
    background: #fff;
    color: #121212;
    border-top: 1px solid #ece7df;
  }

  .home-details__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem;
    align-items: center;
  }

  .home-details__title {
    margin: 1rem 0 0;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .home-details__text {
    margin: 1.35rem 0 0;
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #55534e;
  }

  .home-details__media {
    margin: 0;
    min-width: 0;
  }

  .home-details__frame {
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #ebe7df;
  }

  .home-details__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home-areas {
    background: #f5f4f0;
    color: #121212;
    border-top: 1px solid #ece7df;
  }

  .home-areas__intro {
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem 2.5rem;
  }

  .home-areas__title {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .home-areas__visuals {
    display: grid;
    gap: 1.25rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0 1.25rem;
  }

  .home-areas__hero,
  .home-areas__collage {
    margin: 0;
    min-width: 0;
  }

  .home-areas__frame {
    overflow: hidden;
    background: #ebe7df;
  }

  .home-areas__frame--wide {
    aspect-ratio: 16 / 9;
  }

  .home-areas__frame--collage {
    aspect-ratio: 16 / 11;
  }

  .home-areas__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Kolajın kendi düzenini bozmamak için */
  .home-areas__img--contain {
    object-fit: contain;
    background: #f5f4f0;
  }

  .home-areas__footer {
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 1.25rem 5rem;
  }

  .home-areas__note {
    margin: 0 0 1.25rem;
    max-width: 40rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6f6d67;
  }

  @media (min-width: 768px) {
    .home-details__inner {
      padding: 6rem 3rem;
    }

    .home-areas__intro {
      padding: 6rem 3rem 3rem;
    }

    .home-areas__visuals {
      gap: 1.5rem;
      padding-inline: 3rem;
    }

    .home-areas__footer {
      padding: 2.25rem 3rem 6rem;
    }
  }

  @media (min-width: 1024px) {
    .home-details__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4.5rem;
      padding: 7.5rem 4rem;
    }

    .home-areas__intro {
      padding: 7.5rem 4rem 3.5rem;
    }

    .home-areas__visuals {
      padding-inline: 4rem;
    }

    .home-areas__footer {
      padding: 2.5rem 4rem 7rem;
    }
  }
</style>
