---
import { ArrowRight } from 'lucide-astro';
---
<!-- 3. Yaklaşımımız — yalnızca tipografi -->
<section id="yaklasim" class="home-intro" aria-labelledby="yaklasim-baslik">
  <div class="home-intro__inner">
    <div class="home-intro__left">
      <p class="home-kicker">Yaklaşımımız</p>
      <h2 id="yaklasim-baslik" class="home-intro__title">
        İyi bir yapı,<br />doğru bir fikirle başlar.
      </h2>
    </div>
    <div class="home-intro__right">
      <p class="home-intro__text">
        M&T Mimarlık Mühendislik olarak estetik, işlevsellik ve teknik gereklilikleri birlikte ele alıyoruz.
        Her mekânın kendine özgü ihtiyaçlarından yola çıkarak düşünülmüş, uygulanabilir çözümler geliştirmeyi hedefliyoruz.
      </p>
      <a href="/hakkimizda" class="home-text-link">
        Yaklaşımımızı Keşfedin <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<!-- 4. Mimarlık ve Mühendislik -->
<section id="butuncul" class="home-split" aria-labelledby="butuncul-baslik">
  <div class="home-split__inner">
    <figure class="home-split__media">
      <div class="home-split__frame">
        <img
          src="/images/home/beton-yapi.jpg"
          alt="Konsept mimari görsel: altın saatte modern beton yapı iskeleti"
          width="1536"
          height="1024"
          class="home-split__img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="home-split__copy">
      <p class="home-kicker">Bütüncül Yaklaşım</p>
      <h2 id="butuncul-baslik" class="home-split__title">
        Tasarım ve teknik,<br />aynı bütünün parçaları.
      </h2>
      <p class="home-split__text">
        Bir yapının karakterini mimari tasarım belirlerken, güvenilirliğini ve uygulanabilirliğini mühendislik yaklaşımı destekler.
        Bu iki disiplini projenin ilk aşamasından itibaren birlikte değerlendiriyoruz.
      </p>
      <a href="/hizmetlerimiz" class="home-text-link">
        Hizmetlerimizi İnceleyin <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .home-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #6f6d67;
  }

  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: 1.75rem;
    min-height: 44px;
    border-bottom: 1px solid #121212;
    padding-bottom: 0.15rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #121212;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-text-link:hover {
    opacity: 0.55;
  }

  .home-intro {
    background: #f5f4f0;
    color: #121212;
  }

  .home-intro__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem;
  }

  .home-intro__title {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .home-intro__text {
    margin: 0;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #55534e;
  }

  .home-split {
    background: #fff;
    color: #121212;
    border-top: 1px solid #ece7df;
  }

  .home-split__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 5rem 1.25rem;
    align-items: center;
  }

  .home-split__media {
    margin: 0;
    min-width: 0;
  }

  .home-split__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ebe7df;
  }

  .home-split__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .home-split__media:hover .home-split__img {
    transform: scale(1.02);
  }

  .home-split__copy {
    min-width: 0;
  }

  .home-split__title {
    margin: 1rem 0 0;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .home-split__text {
    margin: 1.35rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #55534e;
  }

  @media (min-width: 768px) {
    .home-intro__inner,
    .home-split__inner {
      padding: 6rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .home-intro__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
      padding: 7.5rem 4rem;
    }

    .home-split__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 4.5rem;
      padding: 7.5rem 4rem;
    }

    .home-split__frame {
      aspect-ratio: 5 / 6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-split__img {
      transition: none;
    }

    .home-split__media:hover .home-split__img {
      transform: none;
    }
  }
</style>
