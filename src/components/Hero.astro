---
import { ArrowRight } from 'lucide-astro';
---
<section id="top" class="home-hero" aria-labelledby="hero-baslik">
  <div class="home-hero__media">
    <img
      src="/images/home/hero-teras.jpg"
      alt="Konsept mimari görsel: deniz manzaralı modern teras ve sonsuzluk havuzu"
      width="1536"
      height="1024"
      class="home-hero__img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="home-hero__veil" aria-hidden="true"></div>

  <div class="home-hero__content">
    <h1 id="hero-baslik" class="home-hero__title">
      Mekânı tasarlıyor,<br />
      yapıyı güvenle<br />
      kuruyoruz.
    </h1>
    <p class="home-hero__lead">
      Mimari tasarım ve mühendislik disiplinlerini bütüncül bir yaklaşımla buluşturuyoruz.
    </p>
    <div class="home-hero__actions">
      <a href="/hizmetlerimiz" class="home-hero__cta">
        Hizmetlerimizi Keşfedin <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a href="/iletisim" class="home-hero__link">Teklif Alın</a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: #111;
    color: #f7f5f1;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% center;
  }

  .home-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(8, 8, 8, 0.62) 0%,
      rgba(8, 8, 8, 0.28) 42%,
      rgba(8, 8, 8, 0.08) 72%,
      rgba(8, 8, 8, 0.12) 100%
    );
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 7.5rem 1.25rem 3.5rem;
  }

  .home-hero__title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .home-hero__lead {
    margin: 1.4rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(247, 245, 241, 0.84);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: 2.1rem;
  }

  .home-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.85rem 1.4rem;
    background: #f7f5f1;
    color: #111;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .home-hero__cta:hover {
    background: #fff;
  }

  .home-hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid rgba(247, 245, 241, 0.55);
    padding-bottom: 0.15rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #f7f5f1;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-hero__link:hover {
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .home-hero__content {
      padding: 8rem 3rem 4.5rem;
    }

    .home-hero__img {
      object-position: 42% center;
    }
  }

  @media (min-width: 1024px) {
    .home-hero__content {
      padding: 9rem 4rem 5.5rem;
    }

    .home-hero__lead {
      font-size: 1.125rem;
    }
  }
</style>
