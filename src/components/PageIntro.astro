---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---
<header class="border-b border-line">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:py-16 lg:px-8 lg:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-intro__title mt-5 max-w-3xl font-normal tracking-tight">
      {title}
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-dark sm:text-lg">
      {lead}
    </p>
    <slot />
  </div>
</header>

<style>
  .page-intro__title {
    font-size: clamp(2rem, 7vw, 2.5rem);
    line-height: 1.08;
  }

  @media (min-width: 640px) {
    .page-intro__title {
      font-size: 3rem; /* text-5xl */
    }
  }

  @media (min-width: 1024px) {
    .page-intro__title {
      font-size: 3.5rem;
    }
  }
</style>
