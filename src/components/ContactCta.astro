---
import { ArrowRight } from 'lucide-astro';
import { site } from '../data/site';

const email = site.contact.email?.trim();
---
<section id="iletisim" class="home-cta" aria-labelledby="iletisim-baslik">
  <div class="home-cta__inner">
    <div class="home-cta__content">
      <p class="home-kicker">Birlikte Başlayalım</p>
      <h2 id="iletisim-baslik" class="home-cta__title">
        Projenizi birlikte<br />şekillendirelim.
      </h2>
      <p class="home-cta__text">
        Fikrinizi, arsanızı veya yapı ihtiyaçlarınızı paylaşın. İlk değerlendirmeyi birlikte yapalım.
      </p>
      <div class="home-cta__actions">
        <a href="/iletisim" class="home-cta__btn">
          İletişime Geçin <ArrowRight size={16} aria-hidden="true" />
        </a>
        {email && (
          <a href={`mailto:${email}`} class="home-cta__mail">{email}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .home-cta {
    background: #FFFFFF;
    color: #151515;
  }

  .home-cta__inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4.5rem 1.25rem;
  }

  .home-cta__content {
    max-width: 640px;
    text-align: left;
  }

  .home-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #777777;
  }

  .home-cta__title {
    margin: 1rem 0 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #151515;
  }

  .home-cta__text {
    margin: 1.35rem 0 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #666666;
  }

  .home-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .home-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.85rem 1.4rem;
    background: #151515;
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .home-cta__btn:hover {
    opacity: 0.88;
  }

  .home-cta__mail {
    font-size: 0.95rem;
    color: #151515;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
    transition: opacity 0.2s ease;
  }

  .home-cta__mail:hover {
    opacity: 0.7;
  }

  @media (min-width: 768px) {
    .home-cta__inner {
      padding: 6.25rem 3rem;
    }

    .home-cta__content {
      max-width: 650px;
    }

    .home-cta__actions {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .home-cta__inner {
      padding: 7rem 4rem;
    }
  }
</style>
