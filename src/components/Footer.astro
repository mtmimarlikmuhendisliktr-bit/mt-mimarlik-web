---
import { Facebook, Instagram, Linkedin, Youtube } from 'lucide-astro';
import Logo from './Logo.astro';
import { site, socialLinks } from '../data/site';

const year = new Date().getFullYear();
const email = site.contact.email?.trim();
const location = 'İstanbul / Türkiye';

const pagesLinks = [
  { label: 'Ana Sayfa', href: '/' },
  { label: 'Hizmetlerimiz', href: '/hizmetlerimiz' },
  { label: 'Projeler', href: '/projeler' },
  { label: 'Referanslar', href: '/referanslar' },
] as const;

const corporateLinks = [
  { label: 'Hakkımızda', href: '/hakkimizda' },
  { label: 'İletişim', href: '/iletisim' },
] as const;

const socialIcons = {
  instagram: Instagram,
  linkedin: Linkedin,
  facebook: Facebook,
  youtube: Youtube,
} as const;

function hasRealSocialHref(href: string) {
  return href.startsWith('http://') || href.startsWith('https://');
}
---
<footer class="site-footer">
  <!-- Temsili arka plan: Unsplash License (mevcut site görselleri) -->
  <div class="site-footer__bg" aria-hidden="true">
    <img
      src="/images/about-architecture.jpg"
      alt=""
      width="2000"
      height="1333"
      class="site-footer__bg-img"
      loading="lazy"
      decoding="async"
    />
    <div class="site-footer__overlay"></div>
  </div>

  <div class="site-footer__main">
    <div class="site-footer__grid">
      <nav class="footer-col" aria-label="Sayfalar">
        <h2 class="footer-col__title">Sayfalar</h2>
        <ul class="footer-col__list">
          {pagesLinks.map((item) => (
            <li>
              <a href={item.href} class="footer-col__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Kurumsal">
        <h2 class="footer-col__title">Kurumsal</h2>
        <ul class="footer-col__list">
          {corporateLinks.map((item) => (
            <li>
              <a href={item.href} class="footer-col__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-col footer-col--contact">
        <h2 class="footer-col__title">İletişim</h2>
        <ul class="footer-col__list">
          <li>
            <p class="footer-col__text">{location}</p>
          </li>
          {email && (
            <li>
              <a href={`mailto:${email}`} class="footer-col__link footer-col__email">
                {email}
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="footer-col footer-col--brand">
        <div class="footer-brand">
          <Logo inverted size="footer" />
          <ul class="footer-social" aria-label="Sosyal medya">
            {socialLinks.map((item) => {
              const linked = hasRealSocialHref(item.href);
              const Icon = item.network !== 'x' ? socialIcons[item.network] : null;
              const iconNode =
                item.network === 'x' ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                ) : (
                  Icon && <Icon size={20} strokeWidth={1.5} aria-hidden="true" />
                );

              return (
                <li>
                  {linked ? (
                    <a
                      href={item.href}
                      class="footer-social__link"
                      aria-label={item.label}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {iconNode}
                    </a>
                  ) : (
                    <span class="footer-social__link footer-social__link--static" aria-label={item.label}>
                      {iconNode}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="site-footer__bar">
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    color: #fff;
    overflow: hidden;
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .site-footer__bg-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .site-footer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
  }

  .site-footer__main {
    position: relative;
    z-index: 1;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3rem 1.25rem;
    align-items: start;
  }

  .footer-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-col__title {
    margin: 0;
    font-size: 1.375rem; /* 22px */
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #fff;
  }

  .footer-col__title::after {
    content: '';
    display: block;
    width: 80px;
    height: 2px;
    margin-top: 0.85rem;
    background: #fff;
  }

  .footer-col__list {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col__link,
  .footer-col__text {
    margin: 0;
    font-size: 1rem; /* 16px */
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col__link:hover {
    color: #fff;
  }

  /* Mobil: uzun e-posta taşmasın */
  .footer-col__email {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer-social {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.62);
    transition: color 0.2s ease;
  }

  .footer-social__link::after {
    content: '';
    position: absolute;
    inset: -10px;
  }

  a.footer-social__link:hover {
    color: #fff;
  }

  .footer-social__link--static {
    cursor: default;
  }

  .footer-social__link :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .site-footer__bar {
    position: relative;
    z-index: 1;
    background: #2b2b2b;
  }

  .site-footer__bar p {
    margin: 0;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0.95rem 1.25rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.25rem;
      row-gap: 2.25rem;
      padding: 3.25rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      /* İletişim sütunu e-posta için daha geniş; başlıklar aynı üst çizgide */
      grid-template-columns:
        minmax(0, 0.95fr)
        minmax(0, 0.95fr)
        minmax(0, 1.55fr)
        minmax(0, 1.15fr);
      column-gap: 2.75rem;
      row-gap: 0;
      padding: 3.5rem 2rem;
    }

    .footer-col__title {
      font-size: 1.5rem; /* 24px */
    }

    .footer-col__email {
      white-space: nowrap;
      overflow-wrap: normal;
      word-break: normal;
    }

    .footer-col--brand {
      justify-self: end;
      width: 100%;
      max-width: 16rem;
    }

    .footer-brand {
      align-items: flex-start;
    }

    .site-footer__bar p {
      padding-inline: 2rem;
    }
  }
</style>
